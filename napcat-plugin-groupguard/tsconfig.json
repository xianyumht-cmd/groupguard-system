{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "napcat-types/napcat-onebot/network/plugin-manger": ["src/shims/napcat-types/napcat-onebot/network/plugin-manger.d.ts"],
      "napcat-types/napcat-onebot/types/index": ["src/shims/napcat-types/napcat-onebot/types/index.d.ts"],
      "napcat-types/napcat-onebot/config/config": ["src/shims/napcat-types/napcat-onebot/config/config.d.ts"]
    },
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
