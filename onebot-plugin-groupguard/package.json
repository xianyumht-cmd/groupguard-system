{
  "name": "onebot-plugin-groupguard",
  "plugin": "群管插件",
  "version": "1.3.0",
  "type": "module",
  "main": "onebot-service.mjs",
  "description": "GroupGuard pure OneBot runtime with SnowLuma and generic host profiles",
  "author": "冷曦",
  "license": "MIT",
  "dependencies": {
    "jimp": "1.6.1",
    "jsqr": "^1.4.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "scripts": {
    "arch:check:system-write": "npm run arch:check:system-write:strict",
    "arch:check:system-write:strict": "node --experimental-strip-types scripts/arch-check-system-write.ts --mode=strict",
    "arch:check:system-write:dev": "node --experimental-strip-types scripts/arch-check-system-write.ts --mode=development",
    "arch:check:system-write:migration": "node --experimental-strip-types scripts/arch-check-system-write.ts --mode=migration",
    "arch:check:system-write:learning": "node --experimental-strip-types scripts/arch-check-system-write.ts --mode=learning",
    "arch:check:risk-policy": "node scripts/arch-check-risk-policy.mjs",
    "arch:hints:system-write": "node --experimental-strip-types scripts/arch-hints-system-write.ts",
    "arch:help": "node --experimental-strip-types scripts/arch-help-system-write.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-verifier-suite.mjs test",
    "build": "npm run build:all",
    "build:release": "npm run build:onebot",
    "build:debug": "node scripts/run-verifier-suite.mjs build:debug",
    "build:snowluma": "node scripts/run-verifier-suite.mjs build:snowluma",
    "build:all": "node scripts/build-all-clean.mjs",
    "bundle:debug": "vite build --mode debug",
    "bundle:snowluma": "vite build --mode snowluma",
    "bundle:onebot": "vite build --mode onebot",
    "resources:sub-gameplay": "node scripts/generate-sub-gameplay-resource-manifest.mjs",
    "verify:sub-gameplay-resources": "node scripts/verify-sub-gameplay-resources.mjs",
    "verify:sub-gameplay-webui": "node --experimental-strip-types scripts/verify-sub-gameplay-webui.mjs",
    "config:migrate:snowluma": "node scripts/migrate-snowluma-config.mjs",
    "dynamic:migrate:http-to-intranet": "node scripts/migrate-dynamic-http-to-intranet.mjs",
    "verify:output-locale": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-output-locale.ts",
    "verify:config-inheritance": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-config-inheritance.ts",
    "verify:content-risk": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-content-risk.ts",
    "verify:group-file-mirror": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-group-file-mirror.ts",
    "verify:target-file-push": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-target-file-push.ts && node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-target-file-dns-pinning.ts",
    "verify:target-file-retention-snowluma": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-target-file-retention-snowluma.ts",
    "verify:action-queue": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/action_queue_regression_test.ts",
    "verify:core-stability": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-core-stability.ts",
    "verify:query-contracts": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-query-contracts.ts",
    "verify:groupguard-delivery-contract": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-groupguard-query-delivery-contract.ts",
    "verify:lol-patch-notifier": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-lol-patch-notifier.ts",
    "verify:per-group-self-recall": "node scripts/test_per_group_self_recall_contract.mjs",
    "verify:intranet-shard-command": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-intranet-shard-command.ts",
    "verify:all-query-fast-migration": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-all-query-fast-migration.ts",
    "verify:intranet-battle-command": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-intranet-battle-command.ts",
    "verify:hidden-retired": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-hidden-retired.ts",
    "verify:intranet-risk-command": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-intranet-risk-command.ts",
    "verify:intranet-dynamic-command": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-intranet-dynamic-command.ts",
    "verify:four-query-three-mode": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-four-query-three-mode.ts",
    "verify:webui-ios-glass": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-webui-ios-glass.ts",
    "verify:all-query-client-boundary": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-all-query-client-boundary.ts",
    "verify:lanzou-update": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-lanzou-update.ts",
    "verify:admin-health": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-admin-health.ts",
    "verify:contract-runner": "node scripts/integration/verify-contract-runner-regression.mjs",
    "verify:release-safety": "node --experimental-strip-types scripts/verify-release-safety.ts",
    "start:snowluma": "node dist/snowluma-service.mjs",
    "report:scene": "node scene_coverage_report.mjs",
    "report:commands": "node scripts/command_coverage_report.mjs",
    "verify:video-retired": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-video-retired.ts",
    "verify:auth-timer-safety": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-auth-timer-safety.ts",
    "verify:project-wide-bugfixes": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-project-wide-bugfixes.ts",
    "verify:host-profiles": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-host-profiles.ts",
    "verify:onebot-runtime": "node --experimental-strip-types --import ./scripts/register-ts-loader.mjs scripts/verify-onebot-runtime-boundary.ts",
    "build:onebot": "node scripts/run-verifier-suite.mjs build:onebot",
    "start:onebot": "node dist/onebot-service.mjs",
    "verify:self-update": "node scripts/verify-self-update-contract.mjs"
  }
}
